<?xml version="1.0"?>
<sdf version="1.9">
  <world name="robotlab_ur5e_cell">
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View"><engine>ogre2</engine><scene>scene</scene><ambient_light>0.65 0.65 0.65</ambient_light><background_color>0.02 0.03 0.06</background_color><camera_pose>-1.35 -1.35 1.55 0 0.68 0.78</camera_pose><camera_clip><near>0.01</near><far>100</far></camera_clip></plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
    </gui>
    <scene><ambient>0.25 0.25 0.28 1</ambient><background>0.02 0.03 0.06 1</background><shadows>true</shadows></scene>
    <light name="key_light" type="directional"><cast_shadows>true</cast_shadows><pose>-1 -1 3 0.4 0 0</pose><diffuse>0.95 0.95 0.9 1</diffuse><specular>0.25 0.25 0.25 1</specular><direction>0.3 0.2 -1</direction></light>
    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><diffuse>0.05 0.06 0.09 1</diffuse></material></visual></link></model>
    <model name="worktable"><static>true</static><pose>0.25 0 0.62 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.8 1.2 0.12</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 1.2 0.12</size></box></geometry><material><diffuse>0.15 0.17 0.2 1</diffuse></material></visual></link></model>
    <model name="board"><static>true</static><pose>0.28 0 0.72 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.62 0.62 0.035</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.62 0.62 0.035</size></box></geometry><material><diffuse>0.03 0.22 0.27 1</diffuse><ambient>0.02 0.08 0.1 1</ambient></material></visual></link></model>
    <!-- Cell centres, row-major 0..8. -->
    <model name="cell_0"><static>true</static><pose>0.12 -0.18 0.75 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.17 0.17 0.018</size></box></geometry><material><diffuse>0.05 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="cell_1"><static>true</static><pose>0.28 -0.18 0.75 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.17 0.17 0.018</size></box></geometry><material><diffuse>0.05 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="cell_2"><static>true</static><pose>0.44 -0.18 0.75 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.17 0.17 0.018</size></box></geometry><material><diffuse>0.05 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="cell_3"><static>true</static><pose>0.12 0 0.75 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.17 0.17 0.018</size></box></geometry><material><diffuse>0.05 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="cell_4"><static>true</static><pose>0.28 0 0.75 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.17 0.17 0.018</size></box></geometry><material><diffuse>0.05 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="cell_5"><static>true</static><pose>0.44 0 0.75 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.17 0.17 0.018</size></box></geometry><material><diffuse>0.05 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="cell_6"><static>true</static><pose>0.12 0.18 0.75 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.17 0.17 0.018</size></box></geometry><material><diffuse>0.05 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="cell_7"><static>true</static><pose>0.28 0.18 0.75 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.17 0.17 0.018</size></box></geometry><material><diffuse>0.05 0.38 0.44 1</diffuse></material></visual></link></model>
    <model name="cell_8"><static>true</static><pose>0.44 0.18 0.75 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.17 0.17 0.018</size></box></geometry><material><diffuse>0.05 0.38 0.44 1</diffuse></material></visual></link></model>

    <model name="ur5e_reference"><pose>-0.35 0 0.76 0 0 0</pose><self_collide>false</self_collide>
      <link name="base_link"><gravity>false</gravity><inertial><mass>4</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.115</radius><length>0.16</length></cylinder></geometry><material><diffuse>0.12 0.16 0.22 1</diffuse></material></visual><collision name="collision"><geometry><cylinder><radius>0.115</radius><length>0.16</length></cylinder></geometry></collision></link>
      <link name="shoulder_link"><pose relative_to="base_link">0 0 0.16 0 0 0</pose><gravity>false</gravity><inertial><mass>2</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.12</radius><length>0.18</length></cylinder></geometry><material><diffuse>0.18 0.22 0.3 1</diffuse></material></visual></link>
      <link name="upper_arm_link"><pose relative_to="shoulder_link">0 0 0 0 0 0</pose><gravity>false</gravity><inertial><mass>3</mass><inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.03</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="visual"><pose>0.2125 0 0 0 0 0</pose><geometry><box><size>0.425 0.12 0.12</size></box></geometry><material><diffuse>0.35 0.39 0.47 1</diffuse></material></visual><collision name="collision"><pose>0.2125 0 0 0 0 0</pose><geometry><box><size>0.425 0.12 0.12</size></box></geometry></collision></link>
      <link name="forearm_link"><pose relative_to="upper_arm_link">0.425 0 0 0 0 0</pose><gravity>false</gravity><inertial><mass>2</mass><inertia><ixx>0.025</ixx><iyy>0.025</iyy><izz>0.025</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="visual"><pose>0.196 0 0 0 0 0</pose><geometry><box><size>0.392 0.105 0.105</size></box></geometry><material><diffuse>0.42 0.46 0.54 1</diffuse></material></visual><collision name="collision"><pose>0.196 0 0 0 0 0</pose><geometry><box><size>0.392 0.105 0.105</size></box></geometry></collision></link>
      <link name="wrist_1_link"><pose relative_to="forearm_link">0.392 0 0 0 0 0</pose><gravity>false</gravity><visual name="visual"><geometry><cylinder><radius>0.075</radius><length>0.13</length></cylinder></geometry><material><diffuse>0.15 0.19 0.25 1</diffuse></material></visual><collision name="collision"><geometry><cylinder><radius>0.075</radius><length>0.13</length></cylinder></geometry></collision></link>
      <link name="wrist_2_link"><pose relative_to="wrist_1_link">0 0 0.13 0 0 0</pose><gravity>false</gravity><visual name="visual"><geometry><cylinder><radius>0.065</radius><length>0.13</length></cylinder></geometry><material><diffuse>0.18 0.23 0.3 1</diffuse></material></visual><collision name="collision"><geometry><cylinder><radius>0.065</radius><length>0.13</length></cylinder></geometry></collision></link>
      <link name="wrist_3_link"><pose relative_to="wrist_2_link">0 0 0.13 0 0 0</pose><gravity>false</gravity><visual name="visual"><geometry><cylinder><radius>0.055</radius><length>0.14</length></cylinder></geometry><material><diffuse>0.1 0.75 0.72 1</diffuse><emissive>0.01 0.08 0.07 1</emissive></material></visual><collision name="collision"><geometry><cylinder><radius>0.055</radius><length>0.14</length></cylinder></geometry></collision></link>
      <joint name="base_anchor" type="fixed"><parent>world</parent><child>base_link</child></joint>
      <joint name="shoulder_pan_joint" type="revolute"><pose relative_to="base_link">0 0 0.16 0 0 0</pose><parent>base_link</parent><child>shoulder_link</child><axis><xyz>0 0 1</xyz><limit><lower>-6.28</lower><upper>6.28</upper></limit></axis></joint>
      <joint name="shoulder_lift_joint" type="revolute"><pose relative_to="shoulder_link">0 0 0 0 0 0</pose><parent>shoulder_link</parent><child>upper_arm_link</child><axis><xyz>0 1 0</xyz><limit><lower>-2.5</lower><upper>0.2</upper></limit></axis></joint>
      <joint name="elbow_joint" type="revolute"><pose relative_to="upper_arm_link">0.425 0 0 0 0 0</pose><parent>upper_arm_link</parent><child>forearm_link</child><axis><xyz>0 1 0</xyz><limit><lower>-2.8</lower><upper>2.8</upper></limit></axis></joint>
      <joint name="wrist_1_joint" type="revolute"><pose relative_to="forearm_link">0.392 0 0 0 0 0</pose><parent>forearm_link</parent><child>wrist_1_link</child><axis><xyz>0 1 0</xyz><limit><lower>-3.2</lower><upper>0.2</upper></limit></axis></joint>
      <joint name="wrist_2_joint" type="revolute"><pose relative_to="wrist_1_link">0 0 0.13 0 0 0</pose><parent>wrist_1_link</parent><child>wrist_2_link</child><axis><xyz>0 0 1</xyz><limit><lower>-6.28</lower><upper>6.28</upper></limit></axis></joint>
      <joint name="wrist_3_joint" type="revolute"><pose relative_to="wrist_2_link">0 0 0.13 0 0 0</pose><parent>wrist_2_link</parent><child>wrist_3_link</child><axis><xyz>0 1 0</xyz><limit><lower>-6.28</lower><upper>6.28</upper></limit></axis></joint>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>shoulder_pan_joint</joint_name><topic>/robotlab/ur5e/shoulder_pan_joint/cmd</topic><p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>0.5</d_gain></plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>shoulder_lift_joint</joint_name><topic>/robotlab/ur5e/shoulder_lift_joint/cmd</topic><p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>0.5</d_gain></plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>elbow_joint</joint_name><topic>/robotlab/ur5e/elbow_joint/cmd</topic><p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>0.5</d_gain></plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>wrist_1_joint</joint_name><topic>/robotlab/ur5e/wrist_1_joint/cmd</topic><p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>0.5</d_gain></plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>wrist_2_joint</joint_name><topic>/robotlab/ur5e/wrist_2_joint/cmd</topic><p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>0.5</d_gain></plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>wrist_3_joint</joint_name><topic>/robotlab/ur5e/wrist_3_joint/cmd</topic><p_gain>8</p_gain><i_gain>0.05</i_gain><d_gain>0.5</d_gain></plugin>
    </model>
    <model name="demo_token"><pose>-0.02 -0.32 0.81 0 0 0</pose><link name="link"><inertial><mass>0.04</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.055</radius><length>0.035</length></cylinder></geometry><material><diffuse>0.95 0.12 0.18 1</diffuse><emissive>0.08 0.01 0.01 1</emissive></material></visual><collision name="collision"><geometry><cylinder><radius>0.055</radius><length>0.035</length></cylinder></geometry></collision></link></model>
    <model name="overhead_camera"><static>true</static><pose>0.28 0 2.05 0 0 0</pose><link name="link"><sensor name="board_camera" type="camera"><pose>0 0 0 -1.5708 0 -1.5708</pose><camera><horizontal_fov>1.05</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>10</far></clip></camera><update_rate>15</update_rate></sensor></link></model>
  </world>
