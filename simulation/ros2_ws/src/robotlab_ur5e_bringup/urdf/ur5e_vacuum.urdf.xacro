<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>
  <link name="vacuum_cup">
    <inertial><origin xyz="0 0 0.04"/><mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/>
    </inertial>
    <visual><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.02" length="0.06"/></geometry>
      <material name="suction_dark"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision name="cup_collision"><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.02" length="0.06"/></geometry></collision>
  </link>
  <joint name="vacuum_mount" type="fixed"><parent link="tool0"/><child link="vacuum_cup"/></joint>
  <gazebo reference="vacuum_mount"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="vacuum_cup">
    <sensor name="cup_contact" type="contact"><always_on>true</always_on><update_rate>100</update_rate>
      <!-- libsdformat renames this collision while lumping the tool0 link. -->
      <contact><collision>vacuum_cup_fixed_joint_lump__cup_collision_collision</collision></contact>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>
    <plugin filename="librobotlab_contact_gripper.so" name="robotlab::ContactGripper">
    <parent_link>vacuum_cup</parent_link><child_model>token</child_model><child_link>token_link</child_link>
    <contact_collision>vacuum_cup_fixed_joint_lump__cup_collision_collision</contact_collision>
  </plugin></gazebo>
</robot>
