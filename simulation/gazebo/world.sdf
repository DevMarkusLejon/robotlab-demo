<?xml version="1.0"?>
<sdf version="1.9">
  <world name="robotlab_tictactoe">
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.25 0.25 0.25 1</ambient>
      <background>0.04 0.05 0.08 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="key_light" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 -1.5 2.5 0.4 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.06 0.07 0.1 1</ambient><diffuse>0.08 0.09 0.13 1</diffuse></material></visual>
      </link>
    </model>

    <model name="board">
      <static>true</static>
      <pose>0.40 0 0.06 0 0 0</pose>
      <link name="board_link">
        <collision name="collision"><geometry><box><size>0.78 0.78 0.08</size></box></geometry></collision>
        <visual name="board_visual"><geometry><box><size>0.78 0.78 0.08</size></box></geometry><material><ambient>0.03 0.12 0.16 1</ambient><diffuse>0.04 0.32 0.38 1</diffuse><specular>0.2 0.4 0.4 1</specular></material></visual>
      </link>
    </model>

    <!-- Nine raised cells make the game board readable from the camera. -->
    <model name="cell_0"><static>true</static><pose>0.18 -0.26 0.115 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.22 0.22 0.025</size></box></geometry><material><diffuse>0.08 0.18 0.23 1</diffuse><ambient>0.05 0.1 0.13 1</ambient></material></visual></link></model>
    <model name="cell_1"><static>true</static><pose>0.40 -0.26 0.115 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.22 0.22 0.025</size></box></geometry><material><diffuse>0.08 0.18 0.23 1</diffuse><ambient>0.05 0.1 0.13 1</ambient></material></visual></link></model>
    <model name="cell_2"><static>true</static><pose>0.62 -0.26 0.115 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.22 0.22 0.025</size></box></geometry><material><diffuse>0.08 0.18 0.23 1</diffuse><ambient>0.05 0.1 0.13 1</ambient></material></visual></link></model>
    <model name="cell_3"><static>true</static><pose>0.18 0 0.115 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.22 0.22 0.025</size></box></geometry><material><diffuse>0.08 0.18 0.23 1</diffuse><ambient>0.05 0.1 0.13 1</ambient></material></visual></link></model>
    <model name="cell_4"><static>true</static><pose>0.40 0 0.115 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.22 0.22 0.025</size></box></geometry><material><diffuse>0.08 0.18 0.23 1</diffuse><ambient>0.05 0.1 0.13 1</ambient></material></visual></link></model>
    <model name="cell_5"><static>true</static><pose>0.62 0 0.115 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.22 0.22 0.025</size></box></geometry><material><diffuse>0.08 0.18 0.23 1</diffuse><ambient>0.05 0.1 0.13 1</ambient></material></visual></link></model>
    <model name="cell_6"><static>true</static><pose>0.18 0.26 0.115 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.22 0.22 0.025</size></box></geometry><material><diffuse>0.08 0.18 0.23 1</diffuse><ambient>0.05 0.1 0.13 1</ambient></material></visual></link></model>
    <model name="cell_7"><static>true</static><pose>0.40 0.26 0.115 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.22 0.22 0.025</size></box></geometry><material><diffuse>0.08 0.18 0.23 1</diffuse><ambient>0.05 0.1 0.13 1</ambient></material></visual></link></model>
    <model name="cell_8"><static>true</static><pose>0.62 0.26 0.115 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.22 0.22 0.025</size></box></geometry><material><diffuse>0.08 0.18 0.23 1</diffuse><ambient>0.05 0.1 0.13 1</ambient></material></visual></link></model>

    <!-- A deliberately simple 3-DOF arm for motion planning experiments. -->
    <model name="robotlab_arm">
      <pose>0 0 0.11 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>2.0</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="base_visual"><geometry><cylinder><radius>0.13</radius><length>0.22</length></cylinder></geometry><material><diffuse>0.16 0.19 0.25 1</diffuse><ambient>0.08 0.1 0.14 1</ambient></material></visual>
        <collision name="base_collision"><geometry><cylinder><radius>0.13</radius><length>0.22</length></cylinder></geometry></collision>
      </link>
      <link name="shoulder_link">
        <pose relative_to="base_link">0 0 0.34 0 0 0</pose>
        <inertial><mass>0.65</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><pose>0.21 0 0 0 0 0</pose><geometry><box><size>0.42 0.10 0.10</size></box></geometry><material><diffuse>0.9 0.32 0.08 1</diffuse><ambient>0.45 0.12 0.02 1</ambient></material></visual>
        <collision name="collision"><pose>0.21 0 0 0 0 0</pose><geometry><box><size>0.42 0.10 0.10</size></box></geometry></collision>
      </link>
      <link name="elbow_link">
        <pose relative_to="shoulder_link">0.42 0 0 0 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.008</ixx><iyy>0.008</iyy><izz>0.008</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="visual"><pose>0.16 0 0 0 0 0</pose><geometry><box><size>0.32 0.085 0.085</size></box></geometry><material><diffuse>0.95 0.68 0.08 1</diffuse><ambient>0.45 0.25 0.02 1</ambient></material></visual>
        <collision name="collision"><pose>0.16 0 0 0 0 0</pose><geometry><box><size>0.32 0.085 0.085</size></box></geometry></collision>
      </link>
      <link name="tool_link">
        <pose relative_to="elbow_link">0.32 0 0 0 0 0</pose>
        <inertial><mass>0.15</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <visual name="tool_visual"><geometry><cylinder><radius>0.055</radius><length>0.16</length></cylinder></geometry><material><diffuse>0.2 0.9 0.85 1</diffuse><ambient>0.05 0.35 0.32 1</ambient><emissive>0.02 0.12 0.1 1</emissive></material></visual>
        <collision name="tool_collision"><geometry><cylinder><radius>0.055</radius><length>0.16</length></cylinder></geometry></collision>
      </link>

      <joint name="base_joint" type="revolute"><parent>base_link</parent><child>shoulder_link</child><axis><xyz>0 0 1</xyz><limit><lower>-3.14</lower><upper>3.14</upper></limit></axis></joint>
      <joint name="shoulder_joint" type="revolute"><pose relative_to="shoulder_link">0 0 0 0 0 0</pose><parent>shoulder_link</parent><child>elbow_link</child><axis><xyz>0 1 0</xyz><limit><lower>-2.3</lower><upper>2.3</upper></limit></axis></joint>
      <joint name="elbow_joint" type="revolute"><pose relative_to="elbow_link">0 0 0 0 0 0</pose><parent>elbow_link</parent><child>tool_link</child><axis><xyz>0 1 0</xyz><limit><lower>-2.6</lower><upper>2.6</upper></limit></axis></joint>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>base_joint</joint_name><topic>/robotlab/arm/base/cmd</topic><p_gain>4</p_gain><i_gain>0.1</i_gain><d_gain>0.2</d_gain></plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>shoulder_joint</joint_name><topic>/robotlab/arm/shoulder/cmd</topic><p_gain>4</p_gain><i_gain>0.1</i_gain><d_gain>0.2</d_gain></plugin>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>elbow_joint</joint_name><topic>/robotlab/arm/elbow/cmd</topic><p_gain>4</p_gain><i_gain>0.1</i_gain><d_gain>0.2</d_gain></plugin>
    </model>

    <!-- One spare puck illustrates where the robot can place a move. -->
    <model name="demo_token"><pose>0.40 0 0.17 0 0 0</pose><link name="link"><inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="visual"><geometry><cylinder><radius>0.075</radius><length>0.035</length></cylinder></geometry><material><diffuse>0.95 0.12 0.18 1</diffuse><ambient>0.5 0.03 0.04 1</ambient><emissive>0.08 0.01 0.01 1</emissive></material></visual><collision name="collision"><geometry><cylinder><radius>0.075</radius><length>0.035</length></cylinder></geometry></collision></link></model>
  </world>
</sdf>
